# ============================================================
# .env.example — Copy to .env and fill in your actual values
# ============================================================

# AWS Configuration
AWS_REGION=us-west-2
AWS_ACCOUNT_ID=YOUR_AWS_ACCOUNT_ID

# Britive Configuration
# Legacy/default profile (used as fallback)
BRITIVE_PROFILE=YourApp/123456789012 (AWS_Env)/FinOps Agentic AI Agent
BRITIVE_TENANT=your-britive-tenant
BRITIVE_REGION=us-west-2

# Britive profiles per agent
BRITIVE_PROFILE_SUPERVISOR=YourApp/123456789012 (AWS_Env)/FinOps Supervisor Agentic AI Agent
BRITIVE_PROFILE_FRAUD=YourApp/123456789012 (AWS_Env)/FinOps Fraud Agentic AI
BRITIVE_PROFILE_COMPLIANCE=YourApp/123456789012 (AWS_Env)/FinOps Compliance Agentic AI
BRITIVE_PROFILE_RISK=YourApp/123456789012 (AWS_Env)/FinOps Risk Analysis Agentic AI

# Britive profile used by deployment shell scripts
BRITIVE_CHECKOUT_PROFILE=YourApp/123456789012 (AWS_Env)/AWS Admin Full Access

# AgentCore Agent IDs (set after deployment)
SUPERVISOR_AGENT_ID=YOUR_SUPERVISOR_AGENT_ID
SUPERVISOR_AGENT_ARN=arn:aws:bedrock-agentcore:us-west-2:YOUR_ACCOUNT_ID:runtime/YOUR_SUPERVISOR_AGENT_ID

FRAUD_AGENT_ID=YOUR_FRAUD_AGENT_ID
FRAUD_AGENT_ARN=arn:aws:bedrock-agentcore:us-west-2:YOUR_ACCOUNT_ID:runtime/YOUR_FRAUD_AGENT_ID

COMPLIANCE_AGENT_ID=YOUR_COMPLIANCE_AGENT_ID
COMPLIANCE_AGENT_ARN=arn:aws:bedrock-agentcore:us-west-2:YOUR_ACCOUNT_ID:runtime/YOUR_COMPLIANCE_AGENT_ID

RISK_AGENT_ID=YOUR_RISK_AGENT_ID
RISK_AGENT_ARN=arn:aws:bedrock-agentcore:us-west-2:YOUR_ACCOUNT_ID:runtime/YOUR_RISK_AGENT_ID

# IAM Execution Role for AgentCore (used by deployment scripts)
BEDROCK_EXECUTION_ROLE=arn:aws:iam::YOUR_ACCOUNT_ID:role/service-role/AmazonBedrockAgentCoreRuntimeServiceRole-yourname

# S3 Buckets for agent data
FRAUD_AGENT_S3_BUCKET=your-fraud-agent-bucket
RISK_AGENT_S3_BUCKET=your-risk-agent-bucket

# Optional API Keys
FINNHUB_API_KEY=demo
TWELVE_DATA_API_KEY=demo

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
PORT=5011
